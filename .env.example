# Copy to .env.local, or run: npm run env:local (fills the Supabase values from the local stack).

# Supabase (local values come from: npx supabase status -o env)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server and tests only. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Test attendants created by supabase/seed.sql (local only, not real accounts)
E2E_ATTENDANT_EMAIL=attendant1@parking.test
E2E_ATTENDANT_EMAIL_2=attendant2@parking.test
E2E_ATTENDANT_PASSWORD=qQNOwH7tBLR1R0Tr

# Where API and E2E tests send requests
APP_URL=http://localhost:3000
